# The bot's HTTP API: replace BOT_HOST with the bot machine's address on your
# home network (port = CARAVAN_API_PORT in the bot's bot.env)
CARAVAN_API_URL=http://BOT_HOST:8787
# Same value as CARAVAN_API_TOKEN in the bot's bot.env
CARAVAN_API_TOKEN=
# Optional overrides:
# CARAVAN_WOW_ROOT=/Applications/World of Warcraft/_forever_
# CARAVAN_WOW_ACCOUNT=123456789#1
# CARAVAN_SV_PATH=/full/path/to/TheCaravan.lua
