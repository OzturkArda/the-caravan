# Discord Developer Portal > your application > Bot > Reset Token
DISCORD_TOKEN=
# Server ID: Discord settings > Advanced > Developer Mode on, then right-click the server icon > Copy Server ID
DISCORD_GUILD_ID=
# Channel for session posts and reminders (right-click the channel > Copy Channel ID).
# Leave empty to post in whichever channel /session add is used.
SESSIONS_CHANNEL_ID=
# Shared secret with the sync app (openssl rand -hex 24)
CARAVAN_API_TOKEN=
CARAVAN_API_HOST=0.0.0.0
CARAVAN_API_PORT=8787
CARAVAN_DB=caravan.db
GROUP_TZ=Australia/Melbourne
REMINDER_OFFSETS=60,15
DEFAULT_DURATION_MIN=180
# Post when someone is more than this many levels above the rest of the group (0 = off)
LEVEL_GAP=3
# Channel for level-gap alerts; empty = SESSIONS_CHANNEL_ID
ALERTS_CHANNEL_ID=
